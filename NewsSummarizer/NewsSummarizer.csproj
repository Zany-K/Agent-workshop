<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
      <UserSecretsId>199d85fd-05ff-4843-b3a8-dd678eb5eab2</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MailKit" Version="4.18.1" />
      <PackageReference Include="Microsoft.Agents.AI" Version="1.24.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
      <PackageReference Include="OllamaSharp" Version="5.5.0" />
      <PackageReference Include="SmartReader" Version="0.11.1" />
      <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
